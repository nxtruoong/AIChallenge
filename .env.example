# Environment variables template for AIChallenge System
# Copy this file to .env and fill in your own API keys.

# Gemini API Keys (used for VQA and Multimodal Captioning)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here

# OpenRouter API Key (used for query distillation and LLM tasks)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DISTILL_API_KEY=your_openrouter_distill_key_here

# ReCap Captioning API (OpenAI-compatible / apimaster.ai / OpenRouter)
RECAP_API_KEY=your_recap_api_key_here
RECAP_API_BASE=https://api.apimaster.ai/v1/chat/completions
RECAP_MODEL=gpt-5.4-mini

# Elasticsearch (Optional, if using Elasticsearch backend)
ES_URL=http://localhost:9200
ES_API_KEY=your_elasticsearch_api_key_here

